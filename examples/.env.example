# drim .env example
#
# drim writes the required variables below when you run `drim setup`.
# Add any optional variables from this file to your `.env` (via `drim configure`)
# to enable GitHub sign-in, SMTP email auth, Redis pub/sub for WebSockets,
# GitHub App integration, and similar features.

# Required (written by `drim setup`)
# KANEO_CLIENT_URL=https://kaneo.example.com
# KANEO_API_URL=https://kaneo.example.com/api
# DATABASE_URL=postgresql://kaneo:password@postgres:5432/kaneo
# POSTGRES_DB=kaneo
# POSTGRES_USER=kaneo
# POSTGRES_PASSWORD=change-me
# AUTH_SECRET=output-of-openssl-rand-hex-32
# DOMAIN=kaneo.example.com

# GitHub OAuth (Sign in with GitHub)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App (repository sync, webhooks)
# GITHUB_APP_ID=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_PRIVATE_KEY=
# GITHUB_APP_NAME=

# SMTP (email sign-in / invitations)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Redis Pub/Sub for WebSockets (optional; in-memory fallback when unset)
# REDIS_URL=redis://redis:6379

# See https://github.com/usekaneo/kaneo/blob/main/.env.sample for the full
# Kaneo reference and https://kaneo.app/docs/core for documentation.